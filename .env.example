# Copy this file to .env and replace the placeholder values.
MONGO_URL=mongodb://127.0.0.1:27017/chatgptbackend
PORT=3000
JWT_SECRET=replace_with_a_long_random_secret
OPENROUTER_API_KEY=put_your_openrouter_api_key_here
DEFAULT_AI_MODEL=openrouter/free
REDIS_URL=redis://127.0.0.1:6379
TOKEN_LIMIT=50000
TOKEN_WINDOW_SECONDS=86400
FRONTEND_URL=http://127.0.0.1:5173
